# ============================================================================
# tai42 REAL-VENDOR E2E — credential template
# ============================================================================
# Copy to REAL_E2E_CREDENTIALS.env, fill every <FILL> value, never commit the
# filled copy.
#
# Three kinds of entry appear below:
#   <FILL>            you supply the value.
#   [AUTO]            self-generated random secret — leave the word AUTO, the
#                     harness generates it at wiring time.
#   [AUTO-DERIVED]    computed from another value (usually E2E_PUBLIC_BASE_URL)
#                     — leave as-is, listed so the picture is complete.
#
# Most names below ARE the exact env var the plugin reads. The exceptions are
# marked [HARNESS-MAPPED]: the plugin reads a different variable (or a JSON
# settings row) and the harness translates your value into it. Fill those the
# same way; only the translation differs.
#
# Harness-side, never in this file: CONNECTORS_KEK and
# CONNECTORS_STATE_HMAC_KEY are minted per run;
# CONNECTORS_REDIRECT_URI_ALLOWLIST is derived from the stack's own origin.
# ============================================================================


# ----------------------------------------------------------------------------
# 0. SHARED PREREQUISITE — public HTTPS endpoint for inbound webhooks
# ----------------------------------------------------------------------------
# WHY: today all inbound webhooks are loopback HTTP calls the test itself
# fires at the SUT. Real vendors (Slack/Telegram/Twilio/GitHub) must reach our
# stack from the internet — impossible without a public HTTPS endpoint.
# A stable staging host with its own domain (durable managed endpoint — not an
# ad-hoc local tunnel). Must be reachable from the public internet over HTTPS.
E2E_PUBLIC_BASE_URL=<FILL: https://your-staging-domain>


# ----------------------------------------------------------------------------
# 1. SLACK — https://api.slack.com/apps
# ----------------------------------------------------------------------------
# WHY: e2e replaces the Slack API with in-process `FakeSlack`
# (tai-e2e src/tai42_e2e/netfixtures.py) — outbound chat.postMessage and
# inbound Events are simulated. Real account proves the actual vendor hop:
# tai-channel-slack notify delivery, allowlist denial, HITL ask_user over a
# real Slack channel, real Events-API signature verification.
#  - OAuth & Permissions -> Bot Token Scopes: chat:write  -> Install to
#    workspace -> copy "Bot User OAuth Token" (xoxb-...)
#  - Basic Information -> App Credentials -> Signing Secret
#  - Event Subscriptions -> enable, Request URL filled at wiring time from
#    E2E_PUBLIC_BASE_URL (needs no value here)
#  - Create a test channel, invite the bot, copy the channel ID (C...)
#  - Bot user id: App Home (or `auth.test`) -> the bot's own "U..." member id.
#    Needed ONLY for the slack BRIDGE route (self-message filter +
#    our_identity); notify / ask_user / signature verification work without it.
CHANNEL_SLACK_BOT_TOKEN=<FILL: xoxb-...>
CHANNEL_SLACK_SIGNING_SECRET=<FILL>
CHANNEL_SLACK_BOT_USER_ID=<FILL: U... (bridge route only; leave empty otherwise)>
CHANNEL_SLACK_TEST_CHANNEL_ID=<FILL: C...>   # [HARNESS-MAPPED -> the channel's *_DEFAULT_RECIPIENT / *_ALLOWED_RECIPIENTS]


# ----------------------------------------------------------------------------
# 2. TELEGRAM — @BotFather in the Telegram app
# ----------------------------------------------------------------------------
# WHY: e2e uses in-process `FakeTelegram` (sendMessage + setWebhook simulated).
# Real bot proves tai-channel-telegram against the live Bot API: real
# setWebhook registration, real delivery, force_reply correlation, secret-token
# verified inbound.
#  - /newbot -> copy the bot token
#  - Start a chat with the bot from your account, get the numeric chat id
#    (e.g. via https://api.telegram.org/bot<TOKEN>/getUpdates after messaging)
CHANNEL_TELEGRAM_BOT_TOKEN=<FILL: 123456:ABC-...>
CHANNEL_TELEGRAM_WEBHOOK_SECRET=AUTO
# Origin the plugin registers with setWebhook at boot — required, it raises
# when unset:
CHANNEL_TELEGRAM_PUBLIC_BASE_URL=[AUTO-DERIVED from E2E_PUBLIC_BASE_URL]
CHANNEL_TELEGRAM_TEST_CHAT_ID=<FILL: numeric chat id>   # [HARNESS-MAPPED -> the channel's *_DEFAULT_RECIPIENT / *_ALLOWED_RECIPIENTS]


# ----------------------------------------------------------------------------
# 3. TWILIO — https://console.twilio.com
# ----------------------------------------------------------------------------
# WHY: e2e uses in-process `FakeTwilio` (Messages API + X-Twilio-Signature
# simulated). Real account proves tai-channel-twilio against live Twilio:
# real SMS + WhatsApp sends, real inbound signature verification, and the
# WhatsApp 24h-session constraint no fake can reproduce.
#  - Account SID + Auth Token: console dashboard
#  - Buy/verify a FROM number (SMS-capable)
#  - WhatsApp: enable the WhatsApp sandbox (Messaging -> Try it out) or an
#    approved WhatsApp sender; sandbox join from the TO phone
#  - TO number: a real phone you control (receives test messages)
CHANNEL_TWILIO_ACCOUNT_SID=<FILL: AC...>
CHANNEL_TWILIO_AUTH_TOKEN=<FILL>
CHANNEL_TWILIO_FROM=<FILL: +1555... (E.164)>
CHANNEL_TWILIO_TEST_TO=<FILL: +9725... (E.164, your phone)>   # [HARNESS-MAPPED -> the channel's *_DEFAULT_RECIPIENT / *_ALLOWED_RECIPIENTS]
# WhatsApp pair (same account; whatsapp:-prefixed numbers). [HARNESS-MAPPED]:
# the plugin has ONE `CHANNEL_TWILIO_FROM` (a whatsapp:-prefixed value passes
# through unchanged) — the harness boots the twilio-whatsapp leg with these
# values in that single setting.
CHANNEL_TWILIO_WHATSAPP_FROM=<FILL: whatsapp:+14155238886 (sandbox) or approved sender>
CHANNEL_TWILIO_WHATSAPP_TEST_TO=<FILL: whatsapp:+9725...>


# ----------------------------------------------------------------------------
# 3b. META WHATSAPP CLOUD API (tai-channel-whatsapp-cloud, M22 PLAN_4) —
#     https://developers.facebook.com
# ----------------------------------------------------------------------------
# WHY: the whatsapp-cloud channel's e2e runs against a fake Meta endpoint
# (configurable api_base_url). Real credentials prove the plugin against the
# live Graph API: real sends from a phone_number_id, real webhook
# verification handshake + X-Hub-Signature-256, and the 24h-session
# constraint no fake can reproduce.
#  - Create a Meta app (Business type) -> add the WhatsApp product; the test
#    number Meta provisions is enough (or an approved production number)
#  - Access token: System User token with whatsapp_business_messaging
#    (temporary dev token works for a first run, expires ~24h)
#  - App secret: App Settings -> Basic -> App Secret (signs webhooks)
#  - Verify token: any random string you choose — must match the value the
#    webhook subscription is registered with (derived at wiring time from
#    E2E_PUBLIC_BASE_URL)
#  - phone_number_id: WhatsApp -> API Setup (NOT the display number)
#  - TO number: a real WhatsApp phone you control; message the business
#    number first from it (opens the 24h session window)
CHANNEL_WHATSAPP_ACCESS_TOKEN=<FILL: EAAG...>
CHANNEL_WHATSAPP_APP_SECRET=<FILL>
CHANNEL_WHATSAPP_VERIFY_TOKEN=AUTO
CHANNEL_WHATSAPP_DEFAULT_PHONE_NUMBER_ID=<FILL: numeric id from API Setup>
CHANNEL_WHATSAPP_TEST_TO=<FILL: wa number of your phone, e.g. 9725...>   # [HARNESS-MAPPED -> the channel's *_DEFAULT_RECIPIENT / *_ALLOWED_RECIPIENTS]


# ----------------------------------------------------------------------------
# 4. GOOGLE CLOUD (connector: Gmail / Calendar / Drive) —
#    https://console.cloud.google.com
# ----------------------------------------------------------------------------
# WHY: e2e never loads tai-connector-google at all — the connectors leg runs a
# fixture provider (`e2e_idp` in tai_e2e_fixtures/connector_provider.py) with
# an in-memory OAuth server. Real account proves the actual plugin: real
# Google OAuth consent + token exchange/refresh and the Gmail/Calendar/Drive
# MCP servers against live Google APIs.
#  - Create project; enable APIs: Gmail API, Google Calendar API, Drive API
#  - OAuth consent screen: External, add the test account below as test user
#  - Credentials -> Create OAuth client ID -> Web application; the redirect
#    URI is derived from E2E_PUBLIC_BASE_URL at wiring time
#  - Test Google account: a throwaway Google account you control (the consent
#    flow is a real browser login with it)
CONNECTORS_GOOGLE_CLIENT_ID=<FILL: ....apps.googleusercontent.com>
CONNECTORS_GOOGLE_CLIENT_SECRET=<FILL: GOCSPX-...>
CONNECTORS_GOOGLE_TEST_ACCOUNT_EMAIL=<FILL: test account email>   # [HARNESS-MAPPED -> test-side only: the identity that drives the consent flow]


# ----------------------------------------------------------------------------
# 5. ATLASSIAN (connector: Jira / Confluence) —
#    https://developer.atlassian.com/console/myapps
# ----------------------------------------------------------------------------
# WHY: same gap as Google — tai-connector-atlassian is never loaded in e2e
# (fixture provider stands in). Real account proves the plugin against live
# Atlassian: 3LO OAuth with rotating refresh tokens and the hosted Rovo MCP
# endpoint (mcp.atlassian.com) over a real Jira/Confluence site.
#  - Create OAuth 2.0 (3LO) app; add Jira + Confluence scopes; callback URL
#    derived from E2E_PUBLIC_BASE_URL at wiring time
#  - A Jira/Confluence Cloud site (free tier OK): https://<site>.atlassian.net
#  - Test Atlassian account with access to that site
CONNECTORS_ATLASSIAN_CLIENT_ID=<FILL>
CONNECTORS_ATLASSIAN_CLIENT_SECRET=<FILL>
CONNECTORS_ATLASSIAN_SITE_URL=<FILL: https://your-site.atlassian.net>   # [HARNESS-MAPPED -> test-side only: the site the leg asserts against]
CONNECTORS_ATLASSIAN_TEST_ACCOUNT_EMAIL=<FILL>   # [HARNESS-MAPPED -> test-side only: the identity that drives the consent flow]


# ----------------------------------------------------------------------------
# 6. OCI OBJECT STORAGE via S3 Compatibility API — https://cloud.oracle.com
# ----------------------------------------------------------------------------
# WHY: the e2e storage axis only ever boots tai-storage-local / the fixture
# storage — tai-storage-s3 has zero e2e coverage (own repo tests mock aioboto3
# with a fake session). Real bucket proves real round-trips: auth, endpoint,
# path-style addressing, checksum behavior of a live S3-compatible store.
#  - Create a dedicated test bucket (Storage -> Buckets)
#  - Creds: Identity & Security -> Users -> your user -> Customer Secret Keys
#    -> Generate -> gives the access key / secret key pair below
#  - Namespace: shown on the bucket page / tenancy details (Object Storage
#    Namespace)
#  - Endpoint: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
STORAGE_S3_BUCKET=<FILL: bucket name>
STORAGE_S3_REGION=<FILL: e.g. eu-frankfurt-1>
STORAGE_S3_ACCESS_KEY=<FILL: customer secret key - access key>
STORAGE_S3_SECRET_KEY=<FILL: customer secret key - secret>
STORAGE_S3_ENDPOINT=<FILL: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com>
# OCI S3-compat requires path-style addressing AND the narrower checksum mode
# (the botocore default `when_supported` adds CRC32 + aws-chunked trailers,
# which non-AWS S3-compatible stores commonly reject on PUT):
STORAGE_S3_ADDRESSING_STYLE=path
STORAGE_S3_REQUEST_CHECKSUM_CALCULATION=when_required


# ----------------------------------------------------------------------------
# 7. GITHUB — https://github.com/settings  (dedicated machine user or org)
# ----------------------------------------------------------------------------
# WHY: three separate mocks fall away with one account:
#  - tai-storage-github: zero e2e coverage; repo tests mock the httpx client.
#    Real repo+PAT proves contents-API read/write round-trips.
#  - tai-marketplace ingest: e2e fakes api.github.com + codeload with
#    `FixturePackageIndex` (tai-e2e pkgsource.py). Real token proves ingest of
#    real plugin repos (metadata, tags, tarball download + sha256).
#  - GitHub social login: today only the in-memory IdP is tested; real OAuth
#    app proves the accounts-oidc `github` preset end-to-end.
# 7a. Storage backend: a dedicated test repo + fine-grained PAT with
#     "Contents: Read and write" on that repo only
STORAGE_GITHUB_USERNAME=<FILL: owner of test repo>
STORAGE_GITHUB_REPO=<FILL: test repo name>
STORAGE_GITHUB_BRANCH=main
STORAGE_GITHUB_TOKEN=<FILL: github_pat_...>
# 7b. Marketplace ingest: PAT with public repo read (raises rate limits);
#     classic PAT with no scopes or fine-grained read-only is enough
MP_GITHUB_TOKEN=<FILL: github_pat_...>
MP_GITHUB_WEBHOOK_SECRET=AUTO
# 7c. GitHub social login (accounts-oidc "github" preset):
#     Settings -> Developer settings -> OAuth Apps -> New OAuth App;
#     callback URL derived from E2E_PUBLIC_BASE_URL at wiring time.
#     [HARNESS-MAPPED] — these become a `TAI_ACCOUNTS_OIDC_PROVIDERS` JSON row
#     with preset "github"; no plugin reads GITHUB_LOGIN_* directly.
GITHUB_LOGIN_CLIENT_ID=<FILL: Iv1... or Ov23...>
GITHUB_LOGIN_CLIENT_SECRET=<FILL>


# ----------------------------------------------------------------------------
# 8. LLM PROVIDERS (real-LLM leg; e2e currently stubs unconditionally)
# ----------------------------------------------------------------------------
# WHY: every e2e LLM call hits `LlmStub` (tai-e2e llmstub.py) — a scripted
# OpenAI-compatible server with deterministic fake embeddings. There is NO
# real-LLM leg at all. Real keys prove agent runs (incl. the babelfish leg)
# against live models: real streaming, tool calls, token/stop behavior,
# provider error shapes, real embedding vectors.
# Minimum: OpenAI (chat + embeddings) and Anthropic (chat).
# https://platform.openai.com/api-keys  /  https://console.anthropic.com
# [HARNESS-MAPPED] — the product reads `LLM_API_KEY`/`LLM_MODEL`/`LLM_BASE_URL`
# (+ the `EMBEDDING_*` twins) selected by `LLM_PROVIDER_LLM`/`_EMBEDDING`; the
# harness fills those from whichever provider below you populate. Provider
# native-env fallbacks are never relied on.
OPENAI_API_KEY=<FILL: sk-...>
ANTHROPIC_API_KEY=<FILL: sk-ant-...>
# Optional extra providers (kit supports them; leave empty to skip):
MISTRAL_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
# Models to run the real leg with (cheap defaults suggested):
REAL_E2E_LLM_MODEL=gpt-4o-mini
REAL_E2E_EMBEDDING_MODEL=text-embedding-3-small
REAL_E2E_ANTHROPIC_MODEL=claude-haiku-4-5-20251001


# ----------------------------------------------------------------------------
# 9. AUTH0 (real OIDC issuer for accounts-oidc + identity-oidc) —
#    https://manage.auth0.com
# ----------------------------------------------------------------------------
# WHY: e2e stands up an in-memory OIDC issuer (`OAuthIdp` in tai-e2e
# netfixtures.py) for both login (tai-accounts-oidc) and API-token validation
# (tai-identity-oidc). Real tenant proves the Auth0 preset against a live
# issuer: real discovery + JWKS fetch, real browser login, real RS256 JWTs
# with issuer/audience enforcement.
#  - Create tenant (free tier OK)
#  - Applications -> Create "Regular Web Application"; callback URL derived
#    from E2E_PUBLIC_BASE_URL at wiring time -> copy domain/client id/secret
#  - APIs -> Create API -> its Identifier is the AUDIENCE for identity-oidc
#  - Create one test user (email+password) in the tenant
# [HARNESS-MAPPED] — no code reads AUTH0_*: the harness turns these into a
# `TAI_ACCOUNTS_OIDC_PROVIDERS` JSON row (preset "auth0") for login, plus
# `TAI_IDENTITY_OIDC_ISSUER` / `TAI_IDENTITY_OIDC_AUDIENCE` for API tokens.
AUTH0_ISSUER=<FILL: https://your-tenant.eu.auth0.com/  (trailing slash!)>
AUTH0_CLIENT_ID=<FILL>
AUTH0_CLIENT_SECRET=<FILL>
AUTH0_AUDIENCE=<FILL: API identifier, e.g. https://tai42-e2e-api>
AUTH0_TEST_USER_EMAIL=<FILL>
AUTH0_TEST_USER_PASSWORD=<FILL>
# HMAC state key for the accounts-oidc login flow:
TAI_ACCOUNTS_OIDC_STATE_KEY=AUTO
# Login redirect origin — required by accounts-oidc, https except loopback:
TAI_ACCOUNTS_OIDC_PUBLIC_BASE_URL=[AUTO-DERIVED from E2E_PUBLIC_BASE_URL]


# ----------------------------------------------------------------------------
# 10. KUBERNETES (config backend) — MANAGED cluster
# ----------------------------------------------------------------------------
# WHY: e2e always runs config in file mode (TAI_CONFIG_MODE=file) —
# tai-config-k8s is never loaded (repo tests use an in-memory FakeCoreV1Api).
# Real cluster proves live Secret/ConfigMap read+patch with resourceVersion
# optimistic concurrency against a real API server.
#  - A managed cloud cluster: OKE (Oracle Kubernetes Engine — rides the OCI
#    tenancy from section 6)
#  - The identity in the kubeconfig needs get+patch on Secrets and ConfigMaps
#    in the namespace below (code patches both, read-only is NOT enough)
# The kubernetes client reads the STANDARD `KUBECONFIG` env var (the plugin has
# no kubeconfig-path setting of its own):
KUBECONFIG=<FILL: /path/to/kubeconfig of the managed cluster>
TAI_K8S_NAMESPACE=tai-e2e


# ----------------------------------------------------------------------------
# 11. LANGFUSE CLOUD — https://cloud.langfuse.com
# ----------------------------------------------------------------------------
# WHY: the e2e monitoring leg runs a docker self-hosted Langfuse with baked
# deterministic keys; the extensions leg uses a recording fixture backend.
# Cloud account proves tai-monitoring-langfuse (trace writes + Metrics/Traces
# API reads) against the managed vendor — auth, project scoping, API drift.
#  - Create org + project; Settings -> API Keys -> create key pair
LANGFUSE_HOST=<FILL: https://cloud.langfuse.com (or EU region URL)>
LANGFUSE_PUBLIC_KEY=<FILL: pk-lf-...>
LANGFUSE_SECRET_KEY=<FILL: sk-lf-...>


# ----------------------------------------------------------------------------
# 12. STRIPE (M24 payments: checkout builder tool + stripe webhook verifier) —
#     https://dashboard.stripe.com  (TEST MODE is enough)
# ----------------------------------------------------------------------------
# WHY: M24 e2e is fully fake (loopback Checkout-API stub + locally signed
# events) — CI needs nothing. Real-vendor leg proves the actual hops: a real
# Checkout Session created against api.stripe.com, and a real dashboard-sent
# `checkout.session.completed` webhook verified by the `stripe` verifier and
# bridged back to the blocked ask_user.
#  - Developers -> API keys -> copy the TEST secret key (sk_test_...)
#  - Developers -> Webhooks -> Add endpoint:
#    {E2E_PUBLIC_BASE_URL}/universal_webhook/payments  (topic name free —
#    must match the topic the verifier + hook are wired to), subscribe to
#    event `checkout.session.completed`, then copy the endpoint's
#    "Signing secret" (whsec_...)
STRIPE_SECRET_KEY=<FILL: sk_test_...>
# The stripe verifier reads whichever env var the hook topic's `secret_env`
# names; the harness binds the topic to THIS name:
STRIPE_WEBHOOK_SECRET=<FILL: whsec_...>
# Door secret authenticating the bridge/reconciler's answer POST to the
# interaction callback door (per-question shared_secret verifier). Must be
# present on EVERY app process AND every backend worker.
TAI_BRIDGE_CALLBACK_SECRET=AUTO
# Origin the payment/HITL callbacks are minted against:
INTERACTIONS_PUBLIC_BASE_URL=[AUTO-DERIVED from E2E_PUBLIC_BASE_URL]


# ----------------------------------------------------------------------------
# NO ACCOUNT NEEDED (for the record — mocks that get real WITHOUT credentials)
# ----------------------------------------------------------------------------
# - PyPI: e2e fakes it with `FixturePackageIndex` (fake /simple/ index + fake
#   wheels). Going real = point marketplace ingest + pip at real pypi.org and
#   use the tai42 packages already published in M11. Reads are anonymous — no
#   credentials exist to fill.
# - GitHub webhook verifier (tai-webhook-verifier-github): already REAL in e2e
#   — it is pure local HMAC verification, zero network; the only input is a
#   shared secret the test mints itself. Nothing to open.
# - Stripe (marketplace billing): `payments_enabled` is a 501 stub;
#   paid-plugins is backlog. The M24 agent-payment flow is section 12 above —
#   marketplace billing remains credential-less until its backlog item starts.
