# tai42-e2e harness settings (TAI_E2E_*). These are the coordinates of the
# externally provided Redis + Postgres the harness connects to and isolates on.
# There are no secrets here — the LLM, IdP, and connector keys are all
# harness-generated or dummy constants.

# The plugin-variant triple this pytest process runs under (see docs/adding-a-test.md).
# An unknown value fails loudly, naming the valid set.
TAI_E2E_BACKEND=arq        # arq | celery | rq
TAI_E2E_IDENTITY=redis     # redis | fixture
TAI_E2E_STORAGE=local      # local | fixture

# The shared Redis (any plain module-free Redis works). No logical DB index here;
# the harness pins each stack to its own index (1-15).
TAI_E2E_REDIS_URL=redis://127.0.0.1:6379

# The module-capable Redis (RediSearch + RedisJSON) for the langgraph redis
# checkpoint/store agents leg. Unset by default: the agents-redis checkpoint
# suite skips when absent. Start it with `docker compose --profile agents-redis
# up -d` and set this to opt in. Its own logical DB pool (0-15), separate from the
# shared Redis above. TAI_E2E_CHECKPOINT_REDIS_PORT moves the compose host port;
# keep the two in step (they default to 6380).
# TAI_E2E_CHECKPOINT_REDIS_PORT=6380
# TAI_E2E_CHECKPOINT_REDIS_URL=redis://127.0.0.1:6380

# RabbitMQ, used ONLY on the celery backend leg (each stack gets its own vhost).
# The AMQP URL feeds the stack broker; the management URL provisions/reaps the vhost.
# Start it with `docker compose --profile celery up -d`.
TAI_E2E_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
TAI_E2E_RABBITMQ_MANAGEMENT_URL=http://guest:guest@127.0.0.1:15672

# The shared Postgres admin connection (for CREATE/DROP DATABASE + the template).
TAI_E2E_PG_HOST=127.0.0.1
TAI_E2E_PG_PORT=5432
TAI_E2E_PG_USER=postgres
TAI_E2E_PG_PASSWORD=postgres
TAI_E2E_PG_ADMIN_DB=postgres

# Seconds a stack may take to reach readiness before boot fails.
TAI_E2E_BOOT_TIMEOUT=30

# Keep per-stack config + log dirs after teardown for debugging (1 to enable).
TAI_E2E_KEEP_STACKS=0


# Opt in to the monitoring suite (requires `docker compose --profile monitoring
# up -d`). When 0, tests/monitoring is skipped at collection.
TAI_E2E_MONITORING=0

# Opt in to the marketplace suite. Boots the ../tai-marketplace sibling checkout
# as harness-managed processes (no extra compose profile; the checkout is already
# required by uv sync). When 0, tests/marketplace is skipped at collection.
TAI_E2E_MARKETPLACE=0

# Opt in to the fleet-consistency suite (boots the multi-worker / REPLICAS stacks
# under the app worker bus). When 0, tests/fleet is skipped at collection.
TAI_E2E_FLEET=0
