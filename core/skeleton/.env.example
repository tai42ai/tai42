# Example environment for tai42-skeleton. Copy to `.env` and fill in.
# Only variable NAMES + placeholders are shown; never commit a real `.env`.
# Each settings group has more knobs than listed here — these are the common ones.

# --- Runtime / config location ----------------------------------------------
# CONFIG_DIR_PATH=./app                 # dir holding manifest.yml + .env (default: /app)
# TAI_MANIFEST_PATH=./manifest.yml      # default for the CLI's --manifest-path flag
#                                       # (the flag itself always wins)
# TAI_TRANSPORT=http                    # http (default) | sse | stdio

# --- Connector engine secrets (base64 of 32 random bytes) -------------------
# Generate each: python -c 'import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())'
CONNECTORS_KEK=
CONNECTORS_STATE_HMAC_KEY=
# CONNECTORS_REDIRECT_URI_ALLOWLIST=   # comma/JSON list of allowed OAuth redirect URIs

# --- Shared connection defaults ---------------------------------------------
# Every DB-backed feature is cleanly OFF until its connection is configured: there
# are NO hidden localhost defaults. An unset feature answers reads empty, refuses
# writes with a 501 machine-readable code, and keeps public doors a uniform 404,
# and one boot log line names the env var that turns it on. Redis-backed features
# resolve their URL from their OWN namespace first, then this shared default:
# TAI_DEFAULT_REDIS_URL=redis://localhost:6379/0

# --- Postgres database registry ---------------------------------------------
# Postgres-backed features share a central registry of NAMED databases. The
# ``default`` database is declared under TAI_DATABASE_DEFAULT_PG_* (fields are the
# connection-settings field names); it is CONFIGURED iff its password is non-empty.
# TAI_DATABASE_DEFAULT_PG_HOST=localhost
# TAI_DATABASE_DEFAULT_PG_PORT=5432
# TAI_DATABASE_DEFAULT_PG_DB=tai42
# TAI_DATABASE_DEFAULT_PG_USER=tai42
# TAI_DATABASE_DEFAULT_PG_PASSWORD=     # supply the DB password here, never in the manifest
# Optional distinct migrator identity, both-or-neither: set BOTH for a distinct
# admin, or neither to migrate under the runtime user/password above (one identity
# for both — the documented default). Exactly one set is a loud error:
# TAI_DATABASE_DEFAULT_PG_ADMIN_USER=
# TAI_DATABASE_DEFAULT_PG_ADMIN_PASSWORD=
# A migration component (the skeleton, each installed plugin) binds to one named
# database via TAI_DB_BINDING_<SLUG> (<SLUG> = the component name uppercased,
# non-[A-Z0-9] -> _); unset binds to ``default``:
# TAI_DB_BINDING_SKELETON=default

# --- Redis-backed feature stores (each OFF until its URL — own var or TAI_DEFAULT_*) -
# TAI_TOOL_RUNS_REDIS_URL=redis://localhost:6379/0   # background tool-run records
# INTERACTIONS_REDIS_URL=redis://localhost:6379/0    # ask_user + internal notifications
# TAI_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0  # public-door rate limiter (OFF = pass-through, one boot WARNING)

# --- Connector token store (turns connectors ON — Postgres truth + Redis cache) -
# Connectors gates on the skeleton's bound database like every other Postgres
# feature: a configured database turns connectors ON — there is no separate intent
# marker. The engine secrets above are then required at first encrypt/sign. The
# Redis token cache rides its own URL or TAI_DEFAULT_REDIS_URL.
# CONNECTOR_STORE_REDIS_URL=redis://localhost:6379/0

# --- Access control (API-key / token auth) ----------------------------------
# ON by default (checks every request against Redis); set false to disable.
# ACCESS_CONTROL_ENABLE=false
# The ordered token-resolution chain, a JSON list; the first provider to recognize a
# credential wins. Defaults to '["redis"]'.
# ACCESS_CONTROL_AUTH_PROVIDERS='["redis"]'
# ACCESS_CONTROL_REDIS_URL=redis://localhost:6379/0
# Exact paths reachable by any AUTHENTICATED identity regardless of the route table
# (jq still applies); a JSON list. Defaults to '["/api/auth/me"]'.
# ACCESS_CONTROL_AUTHENTICATED_ALWAYS_ALLOWED_PATHS='["/api/auth/me"]'
# One-time claim link (QR onboarding): default TTL of the raw-key claim record, in
# seconds. A per-link ttl is capped at ACCESS_CONTROL_CLAIM_LINK_MAX_TTL_SECONDS (3600).
# ACCESS_CONTROL_CLAIM_LINK_TTL_SECONDS=600

# --- Public-door rate limiter (per client bucket; each family independent) --
# COVERAGE is not configured: every route registered authed=False is throttled,
# derived from the route registry, so a new public door is protected the moment it
# registers. What is configured here is each door family's BUDGET — a per-minute
# limit + a 10-second burst window + an enable switch. A family is the door's path
# stem: trigger, universal_webhook, interactions_callback, channels_web, health,
# root (the Studio SPA shell and its assets), ...
# Every family starts from the default budget below, wide enough not to throttle a
# browser fan-out or a busy vendor webhook:
# TAI_RATE_LIMIT_DEFAULT_LIMIT=600
# TAI_RATE_LIMIT_DEFAULT_BURST=120
# TAI_RATE_LIMIT_DEFAULT_ENABLED=true
# Tighter budgets ship for the doors where one request buys real work
# (universal_webhook / interactions_callback / trigger at 60/min + 10/10s, the web
# chat family at 120/min + 30/10s because ONE first page load is the page plus every
# bundle file it links). Override any family — set only the fields you are changing:
# TAI_RATE_LIMIT_FAMILIES='{"trigger": {"limit": 6000, "burst": 600}}'
# TAI_RATE_LIMIT_FAMILIES__TRIGGER__LIMIT=6000   # the same override, one field at a time
# The trigger-link door (/trigger/{token}) executes tools per GET; a NAT'd crowd
# scanning one wall QR shares ONE bucket, so raise its family (and declare your
# proxies below) for crowd-scale deployments.
# --- Client-address resolution (who a request is from) ----------------------
# X-Forwarded-For is believed ONLY under one of these; unset = it is ignored and the
# socket peer is the client (correct when nothing fronts the deployment, and one
# shared bucket for the world when something does — a boot WARNING says so).
# TAI_RATE_LIMIT_TRUSTED_PROXIES=       # JSON list of proxy addresses and/or CIDR blocks
# TAI_RATE_LIMIT_TRUSTED_HOPS=0         # proxies in front, by COUNT; wins over the list above

# --- LLM / embedding providers (used by agents) -----------------------------
# LLM_PROVIDER_LLM=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=                          # provider API key (kept out of logs via SecretStr)
# EMBEDDING_API_KEY=
