# Example environment for tai42-kit. Copy to `.env` and fill in.
# Only variable NAMES + placeholders are shown; never commit a real `.env`.
# tai42-kit is a library — a consuming app usually owns the real `.env`; these are
# the vars tai42-kit's own settings read when used standalone.

# --- LLM / embedding factories (tai42_kit.llm) --------------------------------
# LLM_PROVIDER_LLM=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=                          # provider API key (kept out of logs via SecretStr)
# LLM_PROVIDER_EMBEDDING=openai
# EMBEDDING_API_KEY=
# Checkpoint/store conn strings default to None (unset). Leave them unset to fall
# back per provider to the shared connection namespace below (redis -> the base
# Redis URL, postgres -> the base Postgres DSN); set one only to override.
# LLM_PROVIDER_CHECKPOINT_CONN_STRING=redis://localhost:6379/0
# LLM_PROVIDER_STORE_CONN_STRING=redis://localhost:6379/0

# --- Pooled clients (tai42_kit.clients) — Postgres / Redis --------------------
# Connection identity defaults to None: nothing is configured until env sets it,
# and a None reaching connection building raises a named error (never a hidden
# localhost). Each field reads its own namespace (PG_*, REDIS_URL) first, then
# falls back to the shared TAI_DEFAULT_* namespace.
# PG_HOST=                              # this store's own host (else TAI_DEFAULT_PG_HOST)
# PG_PASSWORD=                          # DB password (SecretStr; kept out of repr/logs)
# REDIS_URL=                            # this store's own URL (else TAI_DEFAULT_REDIS_URL)

# One-block local-dev recipe: the shared namespace every store falls back to.
# Point all DB-backed features at a local Postgres + Redis in one place.
TAI_DEFAULT_REDIS_URL=redis://localhost:6379/0
TAI_DEFAULT_PG_HOST=localhost
TAI_DEFAULT_PG_PORT=5432
TAI_DEFAULT_PG_DB=postgres
TAI_DEFAULT_PG_USER=postgres
TAI_DEFAULT_PG_PASSWORD=postgres
