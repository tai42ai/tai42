# Example environment for tai42-kit. Copy to `.env` and fill in.
# Only variable NAMES + placeholders are shown; never commit a real `.env`.
# tai42-kit is a library — a consuming app usually owns the real `.env`; these are
# the vars tai42-kit's own settings read when used standalone.

# --- LLM / embedding factories (tai42_kit.llm) --------------------------------
# LLM_PROVIDER_LLM=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=                          # provider API key (kept out of logs via SecretStr)
# LLM_PROVIDER_EMBEDDING=openai
# EMBEDDING_API_KEY=
# Checkpoint/store conn strings default to None (unset). Leave them unset to fall
# back per provider to the shared connection namespace below (redis -> the base
# Redis URL, postgres -> the base Postgres DSN); set one only to override.
# LLM_PROVIDER_CHECKPOINT_CONN_STRING=redis://localhost:6379/0
# LLM_PROVIDER_STORE_CONN_STRING=redis://localhost:6379/0

# --- Pooled clients (tai42_kit.clients) — Postgres / Redis --------------------
# Connection identity defaults to None: nothing is configured until env sets it,
# and a None reaching connection building raises a named error (never a hidden
# localhost).
#
# Postgres uses the central database registry: declare a named database under
# TAI_DATABASE_<NAME>_PG_* (a database is CONFIGURED once its password resolves
# non-empty). A migration component binds to one database via
# TAI_DB_BINDING_<COMPONENT_SLUG> (unset binds to "default"). An optional distinct
# migrator identity per database is TAI_DATABASE_<NAME>_PG_ADMIN_USER /
# _PG_ADMIN_PASSWORD, both-or-neither: set BOTH to migrate under a distinct admin,
# or neither to migrate under the runtime user/password. Exactly one set is a loud
# error.
#
# Redis reads its own namespace (REDIS_URL) first, then falls back to the shared
# TAI_DEFAULT_* namespace.
# REDIS_URL=                            # this store's own URL (else TAI_DEFAULT_REDIS_URL)

# One-block local-dev recipe: point the "default" database + Redis at a local
# Postgres + Redis in one place. Every component binds to "default" unless its
# own TAI_DB_BINDING_<COMPONENT_SLUG> names another database.
TAI_DEFAULT_REDIS_URL=redis://localhost:6379/0
TAI_DATABASE_DEFAULT_PG_HOST=localhost
TAI_DATABASE_DEFAULT_PG_PORT=5432
TAI_DATABASE_DEFAULT_PG_DB=postgres
TAI_DATABASE_DEFAULT_PG_USER=postgres
TAI_DATABASE_DEFAULT_PG_PASSWORD=postgres
