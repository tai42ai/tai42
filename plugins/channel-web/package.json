{
  "name": "tai42-channel-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:public": "node scripts/build-public.mjs",
    "build:studio": "node scripts/build-studio.mjs",
    "build": "pnpm run build:public && pnpm run build:studio",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint public-src studio-src",
    "format:check": "prettier --check \"public-src/**/*.{ts,tsx,css}\" \"studio-src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@tai42/studio-sdk": "^34.0.1",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
